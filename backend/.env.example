# Local development environment variables — self-hosted stack
# (SELFHOST_MIGRATION_PLAN.md Phase 6 / docs/architecture/selfhost-migration.md,
# see Appendix A there for the full infra-contract reference)
#
# Replace with real values for API calls to work.
#
# For `docker compose up`, these are supplied by docker-compose.yml instead
# (sourced from the root .env.example / .env) — this file is for running the
# backend directly against a local/dev Postgres, outside Docker.

# ── Database ─────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=team_agile_hub;Username=app;Password=your-local-app-role-password

# ── Auth: app session tokens ────────────────────────────────────────────
# HS256 signing secret for the backend's own session JWTs, >= 32 bytes.
Jwt__SigningSecret=your-32-byte-minimum-random-secret-here
Jwt__Issuer=team-agile-hub
Jwt__Audience=team-agile-hub
Jwt__AccessTokenMinutes=15
Jwt__StaffRefreshDays=7
Jwt__GuestRefreshDays=30

# ── Auth: Microsoft Entra ID (Azure AD) — staff SSO ─────────────────────
# Single-tenant app registration. Redirect URI must be
# https://<host>/api/auth/entra/callback (http://localhost only works with a
# dev tunnel — Entra's OIDC handler requires HTTPS, see
# docs/architecture/selfhost-migration.md §1.3/§1.9 "SameSite interaction").
Entra__TenantId=your-entra-tenant-id
Entra__ClientId=your-entra-app-client-id
# No break-glass/local-admin fallback exists anywhere in this system (§1.7),
# which makes this secret's expiry a full-outage risk — put it on a
# calendar (§1.8), don't let it lapse unnoticed.
Entra__ClientSecret=your-entra-app-client-secret

# Absolute origin used to build redirect URIs without depending solely on
# forwarded-proto headers from the proxy in front of this app.
App__PublicOrigin=https://your-domain

# ── Other integrations (unrelated to the Supabase/self-host migration) ──
Jira__ClientId=wcmZ0ycxANmEf1sQ5bzeiRpvuWy72hvc
Jira__ClientSecret=ATOAxcjA6jOIDIoYWSSDPvZLqPCTasUhF8f3W3Q-Ii7OXdZaJG_Mcj06dVN-TS8e87mn227A0EA6
Jira__RedirectUri=http://localhost:5000/api/jira/callback

OpenAI__ApiKey=your-openai-api-key

Encryption__Key=your-32-byte-hex-key-here

# Supabase__Url / Supabase__ServiceRoleKey / Supabase__JwtSecret are removed
# — Supabase is gone (EF Core + self-hosted Postgres replaces it). See
# AuthExtensions.cs's planned AddAppJwtAuth rewrite in
# docs/architecture/selfhost-migration.md §1.6.
#
# Cors__AllowedOrigins is removed — CORS is deleted outright, not migrated,
# once the frontend and backend are same-origin behind Caddy/rewrites (ADR-1
# in docs/architecture/selfhost-migration.md). Not yet true of the code in
# this repo as of this file (Program.cs still registers AddCors) — this file
# describes the target self-hosted state, not the current one.
