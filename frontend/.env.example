# Frontend environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Local Supabase (npx supabase start) — see "Option A" in the root README.
#
# IMPORTANT: use 127.0.0.1 here, NOT localhost.
# Cookies are scoped by host but NOT by port, so if both the app (localhost:3000)
# and Supabase (localhost:54321) sit on `localhost`, every Supabase auth cookie
# is also sent to Supabase's own API. The chunked session cookies overflow the
# Realtime service's header limit and the websocket dies with
# `431 Request Header Fields Too Large`. Using a different hostname avoids it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# For Supabase Cloud instead, use: https://your-project-ref.supabase.co
# Value is printed by `npx supabase status` as "Publishable" (local),
# or found under Project Settings → API (cloud).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# ── Backend API ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
