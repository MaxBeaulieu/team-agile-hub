# Docker Compose secrets and config for the self-hosted stack
# (SELFHOST_MIGRATION_PLAN.md Phase 6 / docs/architecture/selfhost-migration.md,
# see Appendix A there for the full infra-contract reference).
#
# Copy this file to `.env` (gitignored, same convention as the rest of the
# repo) and fill in real values before running `docker compose up`.
#
# This file is consumed by docker-compose.yml's `${VAR}` substitution and by
# the services it starts. It is separate from backend/.env.local and
# frontend/.env.local, which are only for running those apps directly on the
# host (outside Docker) during development.

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=team_agile_hub

# Superuser. Used only by the postgres container's own initialization
# (creating the app role below, via postgres/init/01-create-app-role.sh) —
# nothing else ever connects with it. See
# docs/architecture/selfhost-migration.md §4.1.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password

# Non-superuser role the backend actually connects as, owning only the
# `public` schema (required so EF Core's Database.Migrate() can create
# tables — Postgres 15+ no longer grants CREATE on `public` to PUBLIC by
# default). Created automatically the *first* time `docker compose up`
# initializes an empty postgres_data volume, by
# postgres/init/01-create-app-role.sh — editing that script later has no
# effect until the volume is recreated.
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=change-me-app-role-password

# ── Backend: auth ────────────────────────────────────────────────────────
# HS256 signing secret for the app's own session JWTs, >= 32 bytes.
JWT_SIGNING_SECRET=change-me-32-bytes-minimum-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_STAFF_REFRESH_DAYS=7
JWT_GUEST_REFRESH_DAYS=30

# Microsoft Entra ID (Azure AD) app registration — staff SSO.
# Single-tenant. Redirect URI must be https://<DOMAIN>/api/auth/entra/callback.
# See docs/architecture/selfhost-migration.md §1.3 and the "Entra app
# registration" open item in SELFHOST_MIGRATION_PLAN.md.
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
# There is deliberately no break-glass/local-admin fallback anywhere in this
# system (§1.7). That makes this secret's expiry a full-outage risk: if it
# lapses unnoticed, nobody — including platform admins — can log in until
# it's rotated. Put the expiry on a calendar (§1.8).
ENTRA_CLIENT_SECRET=your-entra-app-client-secret

# Absolute origin the backend uses to build redirect URIs (e.g. the Entra
# callback) without depending solely on Caddy's X-Forwarded-* headers.
# Must match DOMAIN below and the Entra app registration's redirect URI.
APP_PUBLIC_ORIGIN=https://your-domain

# ── Backend: other integrations (unrelated to the Supabase/self-host migration) ─
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://your-domain/api/jira/callback
OPENAI_API_KEY=
ENCRYPTION_KEY=your-32-byte-hex-key-here

# ── Proxy ────────────────────────────────────────────────────────────────
# Public domain Caddy issues a TLS certificate for. Leave as `localhost` for
# a local/dev run of the full compose stack — Caddy automatically falls back
# to an internal self-signed cert when the host isn't a public domain. Must
# match APP_PUBLIC_ORIGIN above once a real domain is set.
DOMAIN=localhost
